{
  "manifest_version": 3,
  "name": "AutoDL GPU 自动抢机助手",
  "version": "1.1.8",
  "description": "监控实例开机，或按 GPU 型号、数量和价格上限在源地区克隆实例（复制数据盘）",
  "permissions": [
    "storage",
    "notifications",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.autodl.com/*",
    "https://sctapi.ftqq.com/*",
    "https://api.emailjs.com/*",
    "https://api.weixin.qq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.autodl.com/console/instance/list*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.autodl.com/cloneInstance*",
        "https://www.autodl.com/console/instance/list*"
      ],
      "js": [
        "clone-core.js",
        "clone-page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
